ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Optional: defaults to Anthropic's Messages API.
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Optional: raises GitHub API rate limits.
GITHUB_TOKEN=

# Required: Supabase Postgres connection string. Keep this secret.
DATABASE_URL=

# Optional: local admin server port.
ADMIN_PORT=4190

# Recurring worker: keep drafting until 50 active agent-approved proposals.
# Short batches, five-minute cooldown, no automatic publication.
WORKER_TARGET_PROJECTS=50
WORKER_DISCOVERY_HOURS=0.08333333333333333
WORKER_MAX_NO_PROGRESS_RUNS=8
WORKER_REVALIDATION_HOURS=24
WORKER_POLL_SECONDS=60
WORKER_DISCOVERY_LIMIT=5
# Optional short fixed search (max 8 words). Blank rotates topics each batch.
DISCOVERY_QUERY=
# Legacy run-once options; do not run alongside the worker.
DISCOVERY_SOURCES=arxiv,github,government,news
DISCOVERY_LIMIT=5
DISCOVERY_REVIEW_MODE=human_review